# Copia este archivo como .env para usar datos REALES.
# Sin clave, la app funciona con datos simulados realistas.

# Google Places API (New) → https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# Opcional: medir velocidad móvil real con PageSpeed Insights (añade ~10 s por web).
PAGESPEED_API_KEY=

PORT=8787
